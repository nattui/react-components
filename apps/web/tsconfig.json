{
  "compilerOptions": {
    "allowImportingTsExtensions": true, // Vite's configLoader: 'native' (planned future default) requires explicit .ts extensions on vite.config.ts imports
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "#/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "esnext"
  }
}
