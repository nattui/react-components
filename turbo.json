{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".vercel/output/**", "dist/**"]
    },
    "check:type": {},
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    }
  },
  "ui": "stream",
  "envMode": "loose"
}
