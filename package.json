{
  "name": "react-components",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bun run check:format && bun run check:lint && bun run check:type",
    "check:fix": "bun run check:format:fix && bun run check:lint:fix && bun run check:type",
    "check:format": "oxfmt --check",
    "check:format:fix": "oxfmt",
    "check:lint": "oxlint",
    "check:lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "check:type": "turbo check:type",
    "clean": "sh scripts/clean.sh",
    "dev": "turbo dev",
    "update": "bun update --interactive --recursive",
    "version": "npm view @nattstack/ui versions"
  },
  "devDependencies": {
    "eslint-plugin-better-tailwindcss": "4.6.1",
    "eslint-plugin-perfectionist": "5.10.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tailwindcss": "^4.3.2",
    "turbo": "2.10.5"
  },
  "packageManager": "bun@1.3.0",
  "catalog": {
    "@base-ui/react": "1.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2"
  }
}
