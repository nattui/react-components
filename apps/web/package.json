{
  "name": "web",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "check": "bun run check:format && bun run check:lint && bun run check:type",
    "check:fix": "bun run check:format:fix && bun run check:lint:fix && bun run check:type",
    "check:format": "oxfmt --check",
    "check:format:fix": "oxfmt",
    "check:lint": "oxlint",
    "check:lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "check:type": "tsc",
    "dev": "portless ui bun --bun vite dev",
    "preview": "portless ui bun --bun vite preview",
    "update": "bun update --interactive --recursive"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@nattstack/icons": "npm:nucleo-ui-outline-18@1.5.0",
    "@nattstack/ui": "workspace:*",
    "@openpanel/web": "1.4.1",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.28",
    "date-fns": "4.4.0",
    "motion": "12.42.2",
    "nitro": "3.0.260610-beta",
    "react": "19.2.7",
    "react-compare-slider": "4.0.0",
    "react-dom": "19.2.7",
    "sugar-high": "1.2.1",
    "tailwindcss": "4.3.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint-plugin-better-tailwindcss": "4.6.1",
    "eslint-plugin-perfectionist": "5.10.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "portless": "0.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
