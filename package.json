{
  "name": "react-components",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bun run check:format && bun run check:lint",
    "check:fix": "bun run check:format:fix && bun run check:lint:fix",
    "check:format": "oxfmt --check",
    "check:format:fix": "oxfmt",
    "check:lint": "oxlint",
    "check:lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "check:type": "turbo check:type",
    "clean": "sh scripts/clean.sh",
    "dev": "turbo dev",
    "update": "bun update --interactive --recursive",
    "version": "npm view @nattstack/ui versions"
  },
  "devDependencies": {
    "eslint-plugin-perfectionist": "5.9.0",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "turbo": "2.9.6"
  },
  "packageManager": "bun@1.3.0",
  "catalog": {
    "@base-ui/react": "1.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.3"
  }
}
